#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "SlimeChunkPerimeterGen - Minecraft slime chunk perimeter generator"
            VALUE "InternalName", "SlimeChunkPerimeterGen"
            VALUE "LegalCopyright", "MIT license"
            VALUE "OriginalFilename", "SlimeChunkPerimeterGen.exe"
            VALUE "ProductName", "SlimeChunkPerimeterGen"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
